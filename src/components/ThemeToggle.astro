---
import T from './T.astro';
---
<button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
  <span class="visually-hidden"><T en="Dark mode" ko="다크 모드" /></span>
</button>
<script is:inline>
  // Flip the shared theme flag and remember it for every page on the site.
  document.querySelectorAll('[data-theme-toggle]').forEach(button => {
    const root = document.documentElement;
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('site-theme', next); } catch {}
      const apply = () => { window.applySiteTheme(next); sync(); };
      if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(apply);
      else apply();
    });
    window.addEventListener('site-theme-change', sync);
    sync();
  });
</script>
