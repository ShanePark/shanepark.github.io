---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import T from './T.astro';
import type { Text } from '../data/apps';

// Outline icons shared by every landing page's promise list.
const icons = {
  picture: '<rect x="8" y="10" width="32" height="26" rx="6"/><circle cx="18" cy="21" r="4"/><path d="M8 32l10-8 8 6 6-4 8 6"/>',
  finger: '<path d="M20 26V11a4 4 0 0 1 8 0v11l7 2a5 5 0 0 1 3.6 5.6L37 40H20l-6-8a3.5 3.5 0 0 1 5.5-4.3z"/>',
  heart: '<path d="M24 40s-14-8.4-14-18a8 8 0 0 1 14-5.3A8 8 0 0 1 38 22c0 9.6-14 18-14 18z"/>',
  'no-ads': '<circle cx="24" cy="24" r="15"/><path d="M13.5 13.5l21 21"/>',
  shield: '<path d="M24 7l14 5v11c0 9-6 15.5-14 18-8-2.5-14-9-14-18V12z"/><path d="M18 24l4.5 4.5L31 20"/>',
  moon: '<path d="M33 30a12 12 0 0 1-15-15 12 12 0 1 0 15 15z"/><path d="M34 10v6M31 13h6"/>',
  tablet: '<rect x="11" y="6" width="26" height="36" rx="5"/><path d="M21 36h6"/>',
  globe: '<circle cx="24" cy="24" r="15"/><path d="M9 24h30M24 9c-5 5-5 25 0 30M24 9c5 5 5 25 0 30"/>',
  shapes: '<path d="M15 7l9 15H6z"/><circle cx="34" cy="15" r="8"/><rect x="8" y="28" width="14" height="13" rx="3"/><rect x="27" y="28" width="14" height="13" rx="6.5"/>',
  cards: '<rect x="6" y="11" width="17" height="25" rx="4"/><rect x="25" y="11" width="17" height="25" rx="4"/><path d="M14.5 20v7M11 23.5h7"/><circle cx="33.5" cy="23.5" r="3.5"/>',
  palette: '<path d="M24 8C14 8 7 15 7 24s7 16 15 16c3 0 3-3 2-5s0-4 3-4h5c5 0 9-4 9-9 0-8-8-14-17-14z"/><circle cx="16" cy="22" r="2.5"/><circle cx="22" cy="15" r="2.5"/><circle cx="31" cy="17" r="2.5"/>',
  steps: '<circle cx="10" cy="24" r="4"/><circle cx="24" cy="24" r="4"/><circle cx="38" cy="24" r="4"/><path d="M14 24h6M28 24h6"/>',
  speech: '<path d="M10 12h28a4 4 0 0 1 4 4v14a4 4 0 0 1-4 4H22l-8 7v-7h-4a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4z"/><path d="M16 21h16M16 27h10"/>',
};
export type PromiseIcon = keyof typeof icons;

interface Props {
  title: Text;
  /** Illustration shown beside the tiles. */
  art: ImageMetadata;
  items: { icon: PromiseIcon; title: Text }[];
}
const { title, art, items } = Astro.props;
---
<section class="promises" aria-labelledby="promises-title">
  <div class="wrap promises-inner">
    <Image class="promises-art" src={art} alt="" widths={[480, 960]} sizes="(min-width: 900px) 460px, min(520px, 100vw - 32px)" loading="lazy" />
    <div class="promises-body">
      <h2 id="promises-title"><T {...title} /></h2>
      <ul class="promise-list">
        {items.map(item => (
          <li>
            <svg viewBox="0 0 48 48" aria-hidden="true" set:html={icons[item.icon]} />
            <h3><T {...item.title} /></h3>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
