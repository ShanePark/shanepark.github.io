---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import TopbarActions from '../../components/TopbarActions.astro';
import StoreButton from '../../components/StoreButton.astro';
import ScrollStory from '../../components/ScrollStory.astro';
import Promises from '../../components/Promises.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { appById } from '../../data/apps';
import '../../styles/landing.css';
import '../../styles/dalbit.css';
import '../../styles/scroll.css';

import hero from '../../assets/dalbitland/hero.webp';
import heroDay from '../../assets/dalbitland/hero-day.webp';
import promiseArt from '../../assets/dalbitland/promise-moon.webp';
import bunny from '../../assets/dalbitland/bunny.webp';
import balloonPop from '../../assets/dalbitland/game-balloon-pop.webp';
import shapePuzzle from '../../assets/dalbitland/game-shape-puzzle.webp';
import blockStacking from '../../assets/dalbitland/game-block-stacking.webp';
import coloring from '../../assets/dalbitland/game-coloring.webp';
import memoryMatch from '../../assets/dalbitland/game-memory-match.webp';
import carWash from '../../assets/dalbitland/game-car-wash.webp';
import whackAMole from '../../assets/dalbitland/game-whack-a-mole.webp';
import trampoline from '../../assets/dalbitland/game-trampoline.webp';
import cakeMaking from '../../assets/dalbitland/game-cake-making.webp';
import fingerTracing from '../../assets/dalbitland/game-finger-tracing.webp';
import jigsawPuzzle from '../../assets/dalbitland/game-jigsaw-puzzle.webp';
import racing from '../../assets/dalbitland/game-racing.webp';
import wordMatch from '../../assets/dalbitland/game-word-match.webp';
import screenLibraryEn from '../../assets/dalbitland/screen-library-en.webp';
import screenLibraryKo from '../../assets/dalbitland/screen-library-ko.webp';
import screenColoring from '../../assets/dalbitland/screen-coloring.webp';
import screenBalloonPop from '../../assets/dalbitland/screen-balloon-pop.webp';
import screenWordMatchEn from '../../assets/dalbitland/screen-word-match-en.webp';
import screenWordMatchKo from '../../assets/dalbitland/screen-word-match-ko.webp';
import screenRacing from '../../assets/dalbitland/screen-racing.webp';

const app = appById('dalbitland');
const heroImage = await getImage({ src: hero, widths: [800, 1448], format: 'webp' });
const heroDayImage = await getImage({ src: heroDay, widths: [800, 1365], format: 'webp' });

// Display order and names match the in-app game library; each card names the skill it practices.
const games = [
  { src: balloonPop, name: { en: 'Balloon Parade', ko: '달빛 풍선놀이' }, skill: { en: 'Hand-eye', ko: '눈·손 협응' } },
  { src: shapePuzzle, name: { en: 'Shape Puzzle', ko: '모양 퍼즐' }, skill: { en: 'Shapes', ko: '모양 알기' } },
  { src: blockStacking, name: { en: 'Block Stacking', ko: '블록 쌓기' }, skill: { en: 'Timing', ko: '타이밍' } },
  { src: coloring, name: { en: 'Coloring', ko: '색칠 놀이' }, skill: { en: 'Colors', ko: '색깔' } },
  { src: memoryMatch, name: { en: 'Memory Match', ko: '기억 카드' }, skill: { en: 'Memory', ko: '기억력' } },
  { src: carWash, name: { en: 'Car Wash', ko: '세차 놀이' }, skill: { en: 'Step by step', ko: '순서' } },
  { src: whackAMole, name: { en: 'Whack-a-Mole', ko: '두더지 잡기' }, skill: { en: 'Quick eyes', ko: '순발력' } },
  { src: trampoline, name: { en: 'Trampoline', ko: '트램펄린' }, skill: { en: 'Rhythm', ko: '리듬감' } },
  { src: cakeMaking, name: { en: 'Moonlight Bakery', ko: '달빛 케이크 만들기' }, skill: { en: 'Cause and effect', ko: '원인과 결과' } },
  { src: fingerTracing, name: { en: 'Finger Tracing', ko: '손가락 따라 그리기' }, skill: { en: 'Fine motor', ko: '손끝 조절' } },
  { src: jigsawPuzzle, name: { en: 'Jigsaw Puzzle', ko: '조각 퍼즐' }, skill: { en: 'Spatial sense', ko: '공간 감각' } },
  { src: racing, name: { en: 'Racing', ko: '자동차 경주' }, skill: { en: 'Direction', ko: '방향 감각' } },
  { src: wordMatch, name: { en: 'Word Match', ko: '달빛 단어 배달' }, skill: { en: 'First words', ko: '첫 단어' } },
];

const story = [
  { screen: { en: screenLibraryEn, ko: screenLibraryKo }, alt: 'Game cards on the dalbitLand home screen · 달빛랜드 첫 화면의 게임 카드', title: { en: 'Pick a card, start playing', ko: '카드를 골라 바로 시작' }, text: { en: 'No reading needed.', ko: '글을 몰라도 괜찮아요.' } },
  { screen: { en: screenBalloonPop, ko: screenBalloonPop }, alt: 'Colorful balloons floating up under the night sky · 밤하늘로 떠오르는 알록달록 풍선', title: { en: 'Pop, pop, pop', ko: '풍선을 톡톡' }, text: { en: 'Eyes and hands, working together.', ko: '눈과 손이 함께 움직여요.' } },
  { screen: { en: screenWordMatchEn, ko: screenWordMatchKo }, alt: 'A word shown above three picture cards to choose from · 단어 하나와 고를 수 있는 그림 카드 세 장', title: { en: 'Words meet pictures', ko: '단어와 그림 짝꿍' }, text: { en: '445 words in Korean or English.', ko: '한국어·영어 445개 단어.' } },
  { screen: { en: screenColoring, ko: screenColoring }, alt: 'A whale picture ready to color with crayons · 크레용으로 색칠할 고래 그림', title: { en: 'Color a storybook whale', ko: '그림책 고래 색칠하기' }, text: { en: 'Crayons and a paint bucket.', ko: '크레용과 물감 통으로 쓱쓱.' } },
  { screen: { en: screenRacing, ko: screenRacing }, alt: 'Animal friends in karts lined up at the starting line · 출발선에 줄지어 선 동물 친구들의 자동차', title: { en: 'Ready, set, race', ko: '준비, 출발!' }, text: { en: 'Steer left and right around the track.', ko: '왼쪽 오른쪽, 방향을 익혀요.' } },
];

const promises = [
  { icon: 'picture', title: { en: 'Big pictures, big buttons', ko: '큰 그림, 큰 버튼' } },
  { icon: 'no-ads', title: { en: 'No ads or purchases', ko: '광고·결제 없음' } },
  { icon: 'shield', title: { en: 'No data collected', ko: '정보 수집 없음' } },
  { icon: 'moon', title: { en: 'Plays offline', ko: '인터넷 없이 OK' } },
  { icon: 'heart', title: { en: 'No sign-up', ko: '가입·권한 요청 없음' } },
  { icon: 'globe', title: { en: 'Korean and English', ko: '한국어 · English' } },
] as const;

const support = [
  { href: '/dalbitland/support.html', en: 'Support', ko: '고객 지원' },
  { href: '/dalbitland/privacy.html', en: 'Privacy', ko: '개인정보 처리방침' },
];
---
<Base
  title="dalbitLand · 달빛랜드"
  titleKo="달빛랜드 · dalbitLand"
  description="Little games where toddlers play, learn and grow in a moonlit amusement park, on iPhone and iPad. Practice coordination, shapes, colors, memory and first words. No ads, no purchases, no data collected, fully offline."
  icon="/dalbitland/favicon.png"
  touchIcon="/dalbitland/apple-touch-icon.png"
  ogImage="/dalbitland/og.jpg"
  themeColor="#f4ecfd"
  themeColorDark="#14123d"
  theme="theme-dalbit"
>
  <header class="topbar is-floating">
    <a class="topbar-brand" href="/">
      <Image src={app.icon} alt="" width={40} height={40} />
      <span class="brand-name"><T {...app.name} /></span>
    </a>
    <TopbarActions />
  </header>

  <main>
    <section class="dalbit-hero" aria-labelledby="hero-title">
      <img class="dalbit-hero-bg" data-t="dark" src={heroImage.src} srcset={heroImage.srcSet.attribute} sizes="100vw" alt="" loading="lazy">
      <img class="dalbit-hero-bg" data-t="light" src={heroDayImage.src} srcset={heroDayImage.srcSet.attribute} sizes="100vw" alt="" loading="lazy">
      <Image class="dalbit-icon" src={app.icon} alt="" widths={[148, 296]} sizes="148px" loading="eager" />
      <h1 id="hero-title" class="dalbit-title"><T {...app.name} /></h1>
      <p class="dalbit-lead"><T en="First games to play, learn and grow." ko="놀면서 자라는 우리 아이 첫 게임" /></p>
      <StoreButton url={app.appStoreUrl} devices={app.devices} />
      <Image class="dalbit-bunny" src={bunny} alt="" width={150} loading="eager" />
    </section>

    <section class="intro" aria-labelledby="intro-title">
      <div class="wrap">
        <h2 id="intro-title" class="eyebrow"><T en="Made for my own little one" ko="우리 아이를 위해 만들었어요" /></h2>
        <p class="statement"><span class="fill-text"><T en="A few minutes of screen time, turned into joyful play that helps them grow." ko="화면 앞 짧은 시간도, 즐겁게 자라는 놀이가 되도록." /></span></p>
      </div>
    </section>

    <section class="games" aria-labelledby="games-title" style={`--n: ${games.length}`}>
      <div class="wrap games-pin">
        <h2 id="games-title"><T en="Games to grow through play" ko="놀면서 자라는 놀이들" /></h2>
        <ul class="game-list">
          {games.map(game => (
            <li>
              <Image src={game.src} alt="" widths={[240, 480]} sizes="(min-width: 1000px) 270px, (min-width: 640px) 30vw, 64vw" loading="eager" decoding="async" fetchpriority="low" />
              <h3><T {...game.name} /></h3>
              <p class="skill"><T {...game.skill} /></p>
            </li>
          ))}
        </ul>
        <div class="games-progress" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <section class="dalbit-screens" aria-labelledby="screens-title">
      <div class="wrap">
        <h2 id="screens-title"><T en="Big pictures, little hands" ko="큰 그림, 작은 손" /></h2>
      </div>
      <ScrollStory items={story} />
    </section>

    <Promises title={{ en: 'Joyful for kids, easy for grown-ups', ko: '아이는 즐겁게, 보호자는 마음 편히' }} art={promiseArt} items={[...promises]} />

    <section class="closing dalbit-closing" aria-labelledby="closing-title">
      <div class="wrap">
        <Image class="closing-bunny" src={bunny} alt="" width={160} loading="lazy" />
        <h2 id="closing-title"><T en="Coming soon for iPhone and iPad" ko="iPhone과 iPad에서 곧 만나요" /></h2>
        <p class="link-row">
          {support.map(link => <a class="pill-link" href={link.href}><T en={link.en} ko={link.ko} /></a>)}
        </p>
      </div>
    </section>
  </main>

  <SiteFooter links={support} />
</Base>
