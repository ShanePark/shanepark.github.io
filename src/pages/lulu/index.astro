---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import TopbarActions from '../../components/TopbarActions.astro';
import StoreButton from '../../components/StoreButton.astro';
import ScrollStory from '../../components/ScrollStory.astro';
import Promises from '../../components/Promises.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { appById } from '../../data/apps';
import '../../styles/landing.css';
import '../../styles/scroll.css';

import heroTall from '../../assets/lulu/hero-tall.webp';
import heroWide from '../../assets/lulu/hero-wide.webp';
import heroTallNight from '../../assets/lulu/hero-tall-night.webp';
import heroWideNight from '../../assets/lulu/hero-wide-night.webp';
import promiseArt from '../../assets/lulu/promise-picnic.webp';
import wordmark from '../../assets/lulu/wordmark.webp';
import butterfly from '../../assets/lulu/butterfly.webp';
import worldMap from '../../assets/lulu/world-map.webp';
import screenGarden from '../../assets/lulu/screen-garden.webp';
import screenCarousel from '../../assets/lulu/screen-carousel.webp';
import screenSafari from '../../assets/lulu/screen-safari.webp';
import screenFountain from '../../assets/lulu/screen-fountain.webp';
import placeGarden from '../../assets/lulu/place-garden.webp';
import placePark from '../../assets/lulu/place-daeheung-park.webp';
import placeFarm from '../../assets/lulu/place-farm.webp';
import placeDalbit from '../../assets/lulu/place-amusement-park.webp';
import lulu from '../../assets/lulu/friend-lulu.webp';
import sori from '../../assets/lulu/friend-sori.webp';
import jini from '../../assets/lulu/friend-jini.webp';
import hani from '../../assets/lulu/friend-hani.webp';
import hyeoni from '../../assets/lulu/friend-hyeoni.webp';
import yuri from '../../assets/lulu/friend-yuri.webp';

const app = appById('lulu');
const wide = await getImage({ src: heroWide, widths: [960, 1600], format: 'webp' });
const tall = await getImage({ src: heroTall, widths: [480, 800], format: 'webp' });
const wideNight = await getImage({ src: heroWideNight, widths: [960, 1536], format: 'webp' });
const tallNight = await getImage({ src: heroTallNight, widths: [480, 708], format: 'webp' });
const heroes = [
  { theme: 'light', wide, tall },
  { theme: 'dark', wide: wideNight, tall: tallNight },
];
const map = await getImage({ src: worldMap, width: 900, format: 'webp' });

const story = [
  { screen: screenGarden, alt: 'Lulu walking along a garden path while friends hide behind flower bushes · 꽃 덤불 뒤에 친구들이 숨어 있는 정원 길을 걷는 루루', title: { en: 'Hide-and-seek in the flowers', ko: '꽃밭 숨바꼭질' }, text: { en: 'Tap a bush and a friend peeks out.', ko: '덤불을 톡, 친구가 빼꼼.' } },
  { screen: screenCarousel, alt: 'Lulu waiting at the carousel gate in Dalbit Land · 달빛랜드 회전목마 입구에 선 루루', title: { en: 'Hop on the carousel', ko: '회전목마에 올라타요' }, text: { en: 'A Ferris wheel and duck boats too.', ko: '관람차와 오리배도 기다려요.' } },
  { screen: screenSafari, alt: 'Lulu riding the safari bus past friendly animals · 순한 동물들 곁을 지나는 사파리 버스에 탄 루루', title: { en: 'Safari bus friends', ko: '사파리 버스 타고' }, text: { en: 'A slow ride past gentle animals.', ko: '순한 동물 친구들 곁을 천천히.' } },
  { screen: screenFountain, alt: 'Lulu in front of the moon fountain in the plaza · 광장의 달님 분수 앞에 선 루루', title: { en: 'Splash by the moon fountain', ko: '달님 분수 앞에서' }, text: { en: 'Any order, as often as they like.', ko: '순서 없이, 마음 가는 대로.' } },
].map(item => ({ ...item, screen: { en: item.screen, ko: item.screen } }));

const places = [
  { src: placeGarden, name: { en: 'Garden', ko: '정원' } },
  { src: placePark, name: { en: 'Daeheung Park', ko: '대흥공원' } },
  { src: placeFarm, name: { en: 'Farm', ko: '농장' } },
  { src: placeDalbit, name: { en: 'Dalbit Land', ko: '달빛랜드' } },
];

const friends = [
  { src: lulu, en: 'Lulu', ko: '루루' },
  { src: sori, en: 'Sori', ko: '소리' },
  { src: jini, en: 'Jini', ko: '지니' },
  { src: hani, en: 'Hani', ko: '하니' },
  { src: hyeoni, en: 'Hyeoni', ko: '혀니' },
  { src: yuri, en: 'Yuri', ko: '유리' },
];

const promises = [
  { icon: 'picture', title: { en: 'No reading needed', ko: '글 없이 그림으로' } },
  { icon: 'finger', title: { en: 'One finger is enough', ko: '손가락 하나면 충분' } },
  { icon: 'heart', title: { en: 'Nothing to fail', ko: '실패 없는 놀이' } },
  { icon: 'no-ads', title: { en: 'No ads or purchases', ko: '광고·결제 없음' } },
  { icon: 'shield', title: { en: 'No data collected', ko: '정보 수집 없음' } },
  { icon: 'moon', title: { en: 'Easy to stop', ko: '언제든 편히 멈춰요' } },
] as const;
---
<Base
  title="Lulu’s Little Adventures · 루루 어드벤처"
  titleKo="루루 어드벤처 · Lulu’s Little Adventures"
  description="A gentle, picture-only exploring game for little children on iPhone and iPad. No reading, no ads, no purchases, no data collected."
  icon="/lulu/favicon.png"
  touchIcon="/lulu/apple-touch-icon.png"
  ogImage="/lulu/og.jpg"
  themeColor="#bfe3f7"
  themeColorDark="#1a2541"
>
  <header class="topbar is-floating">
    <a class="topbar-brand" href="/">
      <Image src={app.icon} alt="" width={40} height={40} />
      <span class="brand-name"><T {...app.name} /></span>
    </a>
    <TopbarActions />
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      {heroes.map(hero => (
        <picture class="hero-sky" data-t={hero.theme}>
          <source media="(min-aspect-ratio: 4/5)" srcset={hero.wide.srcSet.attribute} sizes="100vw">
          <img src={hero.tall.src} srcset={hero.tall.srcSet.attribute} sizes="100vw" alt="" width={hero.tall.attributes.width} height={hero.tall.attributes.height} loading="lazy">
        </picture>
      ))}
      <div class="hero-inner">
        <h1 id="hero-title" class="wordmark">
          <Image src={wordmark} alt="루루 어드벤처 · Lulu’s Little Adventures" widths={[400, 792]} sizes="min(620px, 92vw)" loading="eager" />
        </h1>
        <p class="hero-lead"><T en="A picture-only world for little explorers." ko="그림만으로 떠나는 꼬마 탐험" /></p>
        <StoreButton url={app.appStoreUrl} devices={app.devices} />
      </div>
      <Image class="hero-mascot" src={lulu} alt="" width={240} loading="eager" />
      <Image class="flutter" src={butterfly} alt="" width={160} loading="eager" />
    </section>

    <section class="intro" aria-labelledby="intro-title">
      <div class="wrap">
        <h2 id="intro-title"><T en="Tap, walk, discover." ko="톡 누르고, 걷고, 발견해요." /></h2>
      </div>
      <ScrollStory items={story} />
    </section>

    <section class="places" aria-labelledby="places-title" style={`--places-bg: url(${map.src})`}>
      <div class="wrap">
        <h2 id="places-title"><T en="Four places to wander" ko="걸어서 만나는 네 곳" /></h2>
        <ul class="place-list">
          {places.map(place => (
            <li>
              <Image src={place.src} alt="" widths={[220, 440]} sizes="220px" loading="lazy" />
              <h3><T {...place.name} /></h3>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="friends" aria-labelledby="friends-title">
      <div class="wrap">
        <h2 id="friends-title"><T en="Lulu and friends" ko="루루와 친구들" /></h2>
        <ul class="friend-list">
          {friends.map(friend => (
            <li><Image src={friend.src} alt="" width={240} loading="lazy" /><T en={friend.en} ko={friend.ko} /></li>
          ))}
        </ul>
      </div>
    </section>

    <Promises title={{ en: 'Made for little hands, kind to grown-ups', ko: '작은 손을 위해, 보호자는 안심하도록' }} art={promiseArt} items={[...promises]} />

    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap closing-inner">
        <Image class="closing-friends" src={sori} alt="" width={240} loading="lazy" />
        <div>
          <h2 id="closing-title"><T en="Coming soon for iPhone and iPad" ko="iPhone과 iPad에서 곧 만나요" /></h2>
          <p class="link-row">
            <a class="pill-link" href="/lulu/support.html"><T en="Support" ko="고객 지원" /></a>
            <a class="pill-link" href="/lulu/privacy.html"><T en="Privacy" ko="개인정보 처리방침" /></a>
          </p>
        </div>
        <Image class="closing-friends" src={jini} alt="" width={240} loading="lazy" />
      </div>
    </section>
  </main>

  <SiteFooter links={[
    { href: '/lulu/support.html', en: 'Support', ko: '고객 지원' },
    { href: '/lulu/privacy.html', en: 'Privacy', ko: '개인정보 처리방침' },
    { href: '/lulu/licenses.html', en: 'Licenses', ko: '라이선스' },
  ]} />
</Base>
