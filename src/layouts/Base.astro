---
import '../styles/base.css';

interface Props {
  title: string;
  titleKo?: string;
  description: string;
  icon?: string;
  touchIcon?: string;
  ogImage?: string;
  themeColor?: string;
  /** Browser chrome color while the dark theme is showing. */
  themeColorDark?: string;
  /** Theme class for app-specific color tokens, such as theme-dalbit. */
  theme?: string;
}
const { title, titleKo = title, description, icon = '/favicon.svg', touchIcon, ogImage, themeColor = '#fff8ee', themeColorDark = '#111829', theme } = Astro.props;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en" data-lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content={themeColor} data-light={themeColor} data-dark={themeColorDark}>
<meta name="referrer" content="no-referrer">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{ogImageUrl && <meta property="og:image" content={ogImageUrl}>}
<meta property="og:type" content="website">
<link rel="icon" href={icon}>
{touchIcon && <link rel="apple-touch-icon" href={touchIcon}>}
<script is:inline define:vars={{ titleKo }}>
  // Pick the language from ?lang=, a remembered choice or the browser before first paint.
  (() => {
    const key = 'site-language';
    const valid = value => value === 'en' || value === 'ko';
    const requested = new URLSearchParams(location.search).get('lang');
    let saved = null;
    try { saved = localStorage.getItem(key); } catch {}
    const language = valid(requested) ? requested
      : valid(saved) ? saved
      : (navigator.language || '').toLowerCase().startsWith('ko') ? 'ko' : 'en';
    if (valid(requested)) {
      try { localStorage.setItem(key, requested); } catch {}
    }
    document.documentElement.lang = language;
    document.documentElement.dataset.lang = language;
    if (language === 'ko') document.title = titleKo;
  })();

  // One light or dark flag for the whole site: a remembered choice, else the system setting.
  (() => {
    const system = matchMedia('(prefers-color-scheme: dark)');
    window.applySiteTheme = theme => {
      document.documentElement.dataset.theme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.content = meta.dataset[theme];
      window.dispatchEvent(new Event('site-theme-change'));
    };
    const saved = () => {
      try {
        const value = localStorage.getItem('site-theme');
        return value === 'light' || value === 'dark' ? value : null;
      } catch { return null; }
    };
    window.applySiteTheme(saved() ?? (system.matches ? 'dark' : 'light'));
    system.addEventListener('change', event => {
      if (!saved()) window.applySiteTheme(event.matches ? 'dark' : 'light');
    });
    // Another tab changed the flag.
    window.addEventListener('storage', event => {
      if (event.key === 'site-theme') window.applySiteTheme(saved() ?? (system.matches ? 'dark' : 'light'));
    });
  })();
</script>
<slot name="head" />
</head>
<body class={theme}>
<slot />
</body>
</html>
