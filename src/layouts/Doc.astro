---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import T from '../components/T.astro';
import TopbarActions from '../components/TopbarActions.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { appById, type Text } from '../data/apps';
import { docSites } from '../data/docs';
import '../styles/landing.css';
import '../styles/dalbit.css';
import '../styles/doc.css';

// Support and policy pages share the landing page's theme and remembered language.
// Each body holds one section per language marked data-l, so only the active one shows.
interface Props {
  appId: string;
  page: string;
  title: Text;
  description: string;
  body: string;
}
const { appId, page, title, description, body } = Astro.props;
const app = appById(appId);
const site = docSites[appId];
---
<Base
  title={`${title.en} · ${app.name.en}`}
  titleKo={`${title.ko} · ${app.name.ko}`}
  description={description}
  icon={site.icon}
  touchIcon={site.touchIcon}
  themeColor={site.themeColor}
  themeColorDark={site.themeColorDark}
  theme={site.theme}
>
  <header class="doc-hero">
    <div class="topbar">
      <a class="topbar-brand" href={app.path}>
        <Image src={app.icon} alt="" width={40} height={40} />
        <span class="brand-name"><T {...app.name} /></span>
      </a>
      <TopbarActions />
    </div>
    <a class="doc-app" href={app.path}>
      <Image class="doc-icon" src={app.icon} alt="" widths={[84, 168]} sizes="84px" loading="eager" />
      <span class="doc-app-name"><T {...app.name} /></span>
    </a>
    <nav class="doc-tabs" aria-label="Pages · 페이지">
      {site.pages.map(p => (
        <a href={p.file} aria-current={p.file === page ? 'page' : undefined}><T en={p.en} ko={p.ko} /></a>
      ))}
    </nav>
  </header>

  <main class="doc-main">
    <div class="doc-card">
      <Fragment set:html={body} />
    </div>
    <p class="doc-back"><a class="pill-link" href={app.path}><T en={`← Back to ${app.name.en}`} ko={`← ${app.name.ko} 소개로 돌아가기`} /></a></p>
  </main>

  <SiteFooter links={site.pages.map(p => ({ href: `${app.path}${p.file}`, en: p.en, ko: p.ko }))} />

  <script is:inline>
    // Build the address on click so it never appears in the page source.
    document.querySelectorAll('[data-contact]').forEach(button => {
      button.addEventListener('click', () => {
        const address = String.fromCharCode(115, 104, 97, 110, 101, 112, 97, 114, 107, 46, 100, 101, 118, 64, 103, 109, 97, 105, 108, 46, 99, 111, 109);
        window.location.href = 'mail' + 'to:' + address;
      });
      button.disabled = false;
    });
  </script>
</Base>
